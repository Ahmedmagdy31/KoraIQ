# ---------------------------------------------------------------- core
ENV=development                     # development | test | staging | production
DATABASE_URL=postgresql+asyncpg://koraiq:koraiq@localhost:5432/koraiq
#   Supabase: use the *session* pooler (port 5432) or direct connection; asyncpg + transaction
#   pooler (6543) needs prepared statements disabled.  Neon: append ?ssl=require
REDIS_URL=redis://localhost:6379/0  # Upstash: rediss://default:<password>@<host>:6379

# ---------------------------------------------------------------- auth
AUTH_MODE=dev                       # MUST be "firebase" in staging/production (enforced at boot)
# Path to the service-account JSON, or the JSON itself inline. On Cloud Run prefer ADC
# (GOOGLE_APPLICATION_CREDENTIALS / attached service account) and leave this empty.
FIREBASE_CREDENTIALS=
FIREBASE_CHECK_REVOKED=false

# ---------------------------------------------------------------- Play Integrity (Standard requests)
INTEGRITY_MODE=off                  # off | soft (unranked) | enforce (403). Cannot be "off" in prod.
ANDROID_PACKAGE_NAME=com.koraiq.app
# Play Console > Release > Setup > App signing > "App signing key certificate" SHA-256,
# base64url-encoded WITHOUT padding (format used in the integrity verdict). JSON list.
INTEGRITY_ALLOWED_CERT_SHA256=[]
# The service account above needs the Play Integrity API enabled in the linked Google Cloud project.
# NOTE: no PLAY_INTEGRITY_DECRYPTION_KEY: Standard requests are decoded by Google's server API
# (decodeIntegrityToken), which is Google's recommended path; local key handling is unnecessary.

# ---------------------------------------------------------------- AdMob
# Numeric part of each rewarded ad unit (after the "/"), JSON list. Empty = accept any (dev only).
ADMOB_ALLOWED_AD_UNITS=[]
# SSV callback URL to register in AdMob for each rewarded unit:
#   https://api.<your-domain>/api/v1/webhooks/admob-ssv

# ---------------------------------------------------------------- product
TERMS_VERSION=2026-11
SUPPORT_EMAIL=privacy@koraiq.app
TRUSTED_PROXY_HOPS=1
CORS_ORIGINS=[]

# ---- v2 gamification (all optional; defaults in backend/app/config.py)
TOPIC_MIN_QUESTIONS=10                # a topic shows up once it has this many active questions
RAMADAN_RANGES=[]                     # e.g. [["2027-02-08","2027-03-09"]] once officially announced
