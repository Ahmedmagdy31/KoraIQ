// Merge into android/app/build.gradle.kts generated by `flutter create` (see mobile/README.md).

plugins {
    id("com.google.gms.google-services") // + classpath/plugin in settings.gradle.kts, via `flutterfire configure`
}

android {
    namespace = "com.koraiq.app"
    defaultConfig {
        applicationId = "com.koraiq.app"
        minSdk = 23 // firebase_auth / google_mobile_ads minimum
    }
    buildTypes {
        getByName("debug") {
            manifestPlaceholders["admobAppId"] = "ca-app-pub-3940256099942544~3347511713" // Google TEST app id
            manifestPlaceholders["usesCleartext"] = "true" // http://10.0.2.2 dev backend
        }
        getByName("release") {
            manifestPlaceholders["admobAppId"] = System.getenv("ADMOB_APP_ID") ?: "MISSING_ADMOB_APP_ID" // CI must set it; AdMob SDK crashes on launch otherwise
            manifestPlaceholders["usesCleartext"] = "false"
            isMinifyEnabled = true
            isShrinkResources = true
        }
    }
}

dependencies {
    implementation("com.google.android.play:integrity:1.4.0") // Standard requests API
}
