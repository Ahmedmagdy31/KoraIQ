# Copy to deploy/.env on the server:  cp deploy/.env.example deploy/.env && nano deploy/.env
# ---- infrastructure (used by docker compose)
DOMAIN=api.koraiq.app                 # A record -> your VPS IP
ACME_EMAIL=you@example.com            # Let's Encrypt expiry notices
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
WEB_CONCURRENCY=2                     # uvicorn workers = vCPUs

# ---- application (read by api/worker/migrate)
AUTH_MODE=firebase
INTEGRITY_MODE=soft                   # soft = unverified devices play unranked; enforce = blocked
ANDROID_PACKAGE_NAME=com.koraiq.app
INTEGRITY_ALLOWED_CERT_SHA256=[]
ADMOB_ALLOWED_AD_UNITS=[]             # numeric rewarded unit ids, e.g. ["5224354917"]
TERMS_VERSION=2026-11
SUPPORT_EMAIL=privacy@koraiq.app

# ---- v2 gamification (all optional; defaults in backend/app/config.py)
TOPIC_MIN_QUESTIONS=10                # a topic shows up once it has this many active questions
RAMADAN_RANGES=[]                     # e.g. [["2027-02-08","2027-03-09"]] once officially announced
